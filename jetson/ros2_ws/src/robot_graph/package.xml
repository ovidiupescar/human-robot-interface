<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_graph</name>
  <version>0.1.0</version>
  <description>Knowledge graph backend (KuzuDB) + identity/memory/location services + scene recognizer</description>
  <maintainer email="ovidiu@artoriuslabs.com">Ovidiu Pescar</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>robot_graph_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
