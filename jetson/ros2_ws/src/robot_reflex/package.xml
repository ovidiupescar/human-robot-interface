<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_reflex</name>
  <version>0.1.0</version>
  <description>Fast reactive behaviors and Hermes event injection (legacy CLI mode only; main path is the platform adapter)</description>
  <maintainer email="ovidiu@artoriuslabs.com">Ovidiu Pescar</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>robot_face_msgs</exec_depend>
  <exec_depend>robot_control_msgs</exec_depend>
  <exec_depend>robot_perception_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
